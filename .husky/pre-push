# Pre-push validation hook
# Runs all monorepo unit tests and type-checks before pushing to remote
COMMIT_MSG=$(git log -1 --pretty=%B)
if echo "$COMMIT_MSG" | grep -q "\[direct\]" || [ "$SKIP_CI" = "true" ]; then
  echo "⏩ Skipping pre-push checks ([direct] flag or SKIP_CI=true)"
else
  pnpm -r run test && pnpm -r run type-check
fi


