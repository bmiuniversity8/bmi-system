{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bmi-api",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "index.ts",

	// ─── Cloudflare Account ────────────────────────────────────────────────────
	// Account: Bmiuniversity107@gmail.com — https://dash.cloudflare.com/3d71aae3dd47db612121c9f7ba281b97
	// account_id is NOT hardcoded here — it is injected at deploy time via the
	// CLOUDFLARE_ACCOUNT_ID environment variable (GitHub Secret).
	// For local `wrangler dev`, run: npx wrangler login  OR  set CLOUDFLARE_API_TOKEN.

	// ─── D1 Database (Cache / Fallback) ───────────────────────────────────────
	// Neon PostgreSQL (DATABASE_URL_CORE secret) is the PRIMARY database.
	// D1 is used ONLY as a local SQLite cache/fallback — never the source of truth
	// in production when DATABASE_URL_CORE is set.
	//
	// To provision on new account (run once, then paste database_id below):
	//   pnpm exec wrangler d1 create bmi-cache-db
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bmi-cache-db",
			"database_id": "REPLACE_AFTER_PROVISIONING"
		}
	],

	// ─── KV Namespace (Catalog Cache-Aside) ───────────────────────────────────
	// Used by lib/cache.ts for high-read catalog endpoints.
	//
	// To provision (run once, then paste id below):
	//   pnpm exec wrangler kv namespace create bmi-catalog-cache
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "REPLACE_AFTER_PROVISIONING",
			"preview_id": "REPLACE_AFTER_PROVISIONING"
		}
	],

	// ─── Queues (Email Delivery) ───────────────────────────────────────────────
	// To provision (run once):
	//   pnpm exec wrangler queues create bmi-email-queue
	"queues": {
		"producers": [
			{
				"queue": "bmi-email-queue",
				"binding": "EMAIL_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "bmi-email-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	},

	// ─── Hyperdrive (Neon Connection Pooler) ──────────────────────────────────
	// Speeds up Neon connections from Workers by pooling at the edge.
	//
	// To provision (run once, then paste id below):
	//   pnpm exec wrangler hyperdrive create bmi-core-hyperdrive \
	//     --connection-string="<DATABASE_URL_CORE from .dev.vars>"
	"hyperdrive": [
		{
			"binding": "CORE_HYPERDRIVE",
			"id": "REPLACE_AFTER_PROVISIONING"
		}
	],

	// ─── R2 Buckets (Documents & Backups) ─────────────────────────────────────
	// To provision (run once):
	//   pnpm exec wrangler r2 bucket create bmi-portal-documents
	//   pnpm exec wrangler r2 bucket create bmi-portal-backups
	"r2_buckets": [
		{
			"binding": "DOCUMENTS",
			"bucket_name": "bmi-portal-documents"
		},
		{
			"binding": "BACKUP_BUCKET",
			"bucket_name": "bmi-portal-backups"
		}
	],

	// ─── Public Environment Variables ─────────────────────────────────────────
	// Non-secret config baked into the Worker at deploy time.
	// Secrets (JWT_SECRET, DATABASE_URL_CORE, etc.) are set via `wrangler secret put`.
	"vars": {
		"ENVIRONMENT": "production",
		"ALLOWED_ORIGINS_OVERRIDE": "https://bmiuniversities.org,https://www.bmiuniversities.org,https://portal.bmiuniversities.org,https://ums.bmiuniversities.org,https://bmi-portal.pages.dev,https://bmi-ums.pages.dev,https://bmi-university.pages.dev,https://bmi-portal.hkmministries.org,https://bmi-ums.hkmministries.org"
	},

	// ─── Cron Triggers ────────────────────────────────────────────────────────
	// Runs scheduled tasks (backup, archival) daily at midnight UTC.
	"triggers": {
		"crons": ["0 0 * * *"]
	},

	// ─── Observability ────────────────────────────────────────────────────────
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}