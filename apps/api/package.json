{
  "name": "@bmi/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply bmi-portal-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply bmi-portal-db --local",
    "verify-migrations": "tsx scripts/verify-migrations.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:hr": "drizzle-kit generate --config drizzle-hr.config.ts",
    "db:generate:library": "drizzle-kit generate --config drizzle-library.config.ts",
    "db:generate:alumni": "drizzle-kit generate --config drizzle-alumni.config.ts",
    "db:generate:all": "pnpm run db:generate && pnpm run db:generate:hr && pnpm run db:generate:library && pnpm run db:generate:alumni",
    "db:push:core": "drizzle-kit push --config drizzle.config.ts",
    "db:push:hr": "drizzle-kit push --config drizzle-hr.config.ts",
    "db:push:library": "drizzle-kit push --config drizzle-library.config.ts",
    "db:migrate-to-neon": "tsx scripts/migrate-d1-to-neon.ts",
    "db:verify-migration": "tsx scripts/verify-data-migration.ts",
    "type-check": "tsc --noEmit",
    "secrets:set": "node ../../scripts/upload-worker-secrets.mjs",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@bmi/adapters": "workspace:*",
    "@bmi/api-middleware": "workspace:*",
    "@bmi/bootstrap": "workspace:*",
    "@bmi/ports": "workspace:*",
    "@bmi/shared": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/cloudflare": "10.62.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^5.0.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@cloudflare/unenv-preset": "^2.16.1",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^4.20260701.1",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "typescript": "5.8.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
